# Gemini AI — server-only, never use NEXT_PUBLIC_ prefix (would expose key in browser bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (database: newsletter subscribers, leads, article views)
# Project Settings → API → Project URL / Project API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Hero background shader (optional).
# "on" swaps the CSS hero backdrop for the WebGPU shader stack from the
# `shaders` npm package. Leave unset for the CSS version — the package needs a
# commercial licence for public deployments and a WebGPU-capable browser.
NEXT_PUBLIC_HERO_SHADER=off
